[resource]
script = ExtResource("2_mqbdk")
id = "forest"
display_name = "Forest"
description = "A region dominated by dense tree cover. Rich in renewable resources, though finding them still requires time and effort."
first_visit_text = "The wilderness closes around Finnley beneath a roof of tangled branches. The forest offers shelter, timber, and food, but nothing freely. Every useful thing will have to be found, understood, and earned."
available_actions = Array[ExtResource("1_ov7sf")]([ExtResource("2_36u8b"), ExtResource("3_7q3hv"), ExtResource("4_mnpna")])
travel_connections = Array[ExtResource("5_e2bfc")]([SubResource("Resource_mqbdk"), SubResource("Resource_36u8b"), null])
search_loot = Array[ExtResource("5_ov7sf")]([SubResource("Resource_r8hcy"), SubResource("Resource_3pxe2"), SubResource("Resource_jwej7"), SubResource("Loot_hardwood"), SubResource("Loot_brown_cap")])
